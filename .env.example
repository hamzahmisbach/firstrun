# FirstRun configuration. On the VM, infra/setup-vm.sh copies this file to /etc/firstrun/firstrun.env
# (root:firstrun 0640). Never commit real values.

# Vultr Serverless Inference: console > Products > Serverless > Inference > (subscription) > API key
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Vultr Object Storage (S3-compatible), endpoint like https://sgp1.vultrobjects.com
FIRSTRUN_S3_ENDPOINT=
FIRSTRUN_S3_BUCKET=
FIRSTRUN_S3_ACCESS_KEY=
FIRSTRUN_S3_SECRET_KEY=
FIRSTRUN_REPORT_TTL_DAYS=30

# Public URL served by nginx (e.g. https://firstrun.example.org); infra/setup-https.sh sets it on the VM.
FIRSTRUN_PUBLIC_URL=
FIRSTRUN_LISTEN=127.0.0.1:3000

# Free-form commands need this code (at least 24 random characters); curated samples stay open.
FIRSTRUN_ACCESS_CODE=
FIRSTRUN_FREEFORM=1
# Flags must be exactly 0 or 1; any other value stops the server at startup.
FIRSTRUN_KILL_SWITCH=0
# Creating this file also disables new runs, without a restart (docs/ARCHITECTURE.md 11).
FIRSTRUN_KILL_SWITCH_FILE=/srv/firstrun/KILL_SWITCH
# Curated samples: <dir>/<id>/{command.txt,claim.txt[,meta.json,expected.json,canned.json]}.
# Leave empty to use <repo>/fixtures/samples; read once at startup.
FIRSTRUN_SAMPLES_DIR=

# Paths on the VM (defaults match infra/setup-vm.sh).
FIRSTRUN_RUNS_DIR=/srv/firstrun/runs
FIRSTRUN_TRACE_DIR=/srv/firstrun/trace
FIRSTRUN_SINK_SOCKET=/run/firstrun/gvisor-sink.sock
# runsc --debug-log directory from infra/docker/daemon.json: <cid>.boot.log holds the file changes.
FIRSTRUN_RUNSC_LOG_DIR=/var/log/firstrun/runsc

# Evidence source: only trace (gVisor trace points plus the runsc strace log for file changes).
FIRSTRUN_EVIDENCE=trace
# 1 = skip every LLM call and use the deterministic fallbacks (development without a key).
FIRSTRUN_LLM_DISABLED=0
