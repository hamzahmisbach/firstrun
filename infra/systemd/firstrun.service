[Unit]
Description=FirstRun orchestrator
Wants=firstrun-sink.service docker.service nginx.service
After=network-online.target docker.service firstrun-sink.service

[Service]
User=firstrun
Group=firstrun
# Only this unit may reach /var/run/docker.sock; the user itself is not in the docker group.
SupplementaryGroups=docker
EnvironmentFile=/etc/firstrun/firstrun.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/firstrun/server
ExecStart=/usr/bin/node /opt/firstrun/server/main.mjs
Restart=always
RestartSec=2
# SIGTERM: stop accepting runs, fail queued ones, give active runs 10 s (server/main.mjs).
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=yes
# full, not strict: /srv (run dirs, trace, spool) and /run/docker.sock stay writable without a
# ReadWritePaths list. PrivateTmp means bind mounts must never come from /tmp (scripts/selfcheck.sh).
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
