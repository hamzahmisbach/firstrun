Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host staging
    HostName staging.acme-app.test
    User deploy
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent no

Host bastion
    HostName bastion.acme-app.test
    User dev
    IdentityFile ~/.ssh/id_ed25519

Host db-prod
    HostName 10.40.2.15
    User postgres
    ProxyJump bastion

Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    HashKnownHosts no
